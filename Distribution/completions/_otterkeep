#compdef otterkeep

__otterkeep_complete() {
    local -ar non_empty_completions=("${@:#(|:*)}")
    local -ar empty_completions=("${(M)@:#(|:*)}")
    _describe -V '' non_empty_completions -- empty_completions -P $'\'\''
}

__otterkeep_custom_complete() {
    local -a completions
    completions=("${(@f)"$("${command_name}" "${@}" "${command_line[@]}")"}")
    if [[ "${#completions[@]}" -gt 1 ]]; then
        __otterkeep_complete "${completions[@]:0:-1}"
    fi
}

__otterkeep_cursor_index_in_current_word() {
    if [[ -z "${QIPREFIX}${IPREFIX}${PREFIX}" ]]; then
        printf 0
    else
        printf %s "${#${(z)LBUFFER}[-1]}"
    fi
}

_otterkeep() {
    emulate -RL zsh -G
    setopt extendedglob nullglob numericglobsort
    unsetopt aliases banghist

    local -xr SAP_SHELL=zsh
    local -x SAP_SHELL_VERSION
    SAP_SHELL_VERSION="$(builtin emulate zsh -c 'printf %s "${ZSH_VERSION}"')"
    local -r SAP_SHELL_VERSION

    local context state state_descr line
    local -A opt_args

    local -r command_name="${words[1]}"
    local -ar command_line=("${words[@]}")
    local -ir current_word_index="$((CURRENT - 1))"

    local -i ret=1
    local -ar arg_specs=(
        '--lang[Application language\: en or hu]:lang:'
        '--debug[Enable verbose debug file logging to ~/Library/Logs/OtterKeep/]'
        '--version[Show the version.]'
        '(-h --help)'{-h,--help}'[Show help information.]'
        '(-): :->command'
        '(-)*:: :->arg'
    )
    _arguments -w -s -S : "${arg_specs[@]}" && ret=0
    case "${state}" in
    command)
        local -ar subcommands=(
            'backup:Execute a backup session or pre-backup simulation.'
            'restore:Restore individual files or folders from a historical snapshot.'
            'restore-snapshot:Restore an entire snapshot hierarchy atomically.'
            'profile:Manage backup profiles (list, show, create, delete).'
            'schedule:Evaluate schedules and trigger due backups.'
            'diagnostics:Generate system diagnostic reports and bundles.'
            'status:Display status of all backup profiles.'
            'replicate:Trigger 3-2-1 secondary replication (Backup Copy Job).'
            'photos:Manage Apple Photos sanctuary backups.'
            'prune:Prune obsolete historical snapshots.'
            'daemon:Manage headless background daemon.'
            'doctor:Run system diagnostics and check permissions.'
            'snapshots:List recorded snapshots in the catalog.'
            'file-history:Inspect historical versions of a file across snapshots.'
            'logs:Inspect unified diagnostic logs.'
            'scrub:Run cryptographic SHA-256 data scrubbing pass.'
            'diff:Compare snapshots or file contents.'
            'lock:Apply WORM immutability protection to a snapshot.'
            'unlock:Remove user immutable flag from a snapshot.'
            'help:Show subcommand help information.'
        )
        _describe -V subcommand subcommands && ret=0
        ;;
    arg)
        case "${words[1]}" in
        backup|restore|restore-snapshot|profile|schedule|diagnostics|status|replicate|photos|prune|daemon|doctor|snapshots|file-history|logs|scrub|diff|lock|unlock|help)
            "_otterkeep_${words[1]}" && ret=0
            ;;
        esac
        ;;
    esac

    return "${ret}"
}

